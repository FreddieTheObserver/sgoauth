# --- Postgres (read by docker-compose.yml) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=
POSTGRES_DB=sgoauth

# --- App ---
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
API_PORT=4000
DATABASE_URL=postgresql://app:CHANGEME@localhost:5432/sgoauth?schema=public

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# --- Secrets: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))" ---
OAUTH_TX_SECRET=              # 32 bytes base64 — encrypts the handshake cookie
IP_HASH_SALT=                 # 32 bytes base64 — we store hashed IPs, not raw

# --- Sessions ---
SESSION_TTL_DAYS=7            # sliding
SESSION_ABSOLUTE_TTL_DAYS=30  # hard cap, never extended
COOKIE_PREFIX=__Host-
ALLOWED_HD=                   # optional: lock to one Google Workspace domain
